# ==============================================================================
# Application Settings
# ==============================================================================
PROJECT_NAME="Ticket Booking Dual-DB API"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================================================================
# PostgreSQL Database Settings (Transactional Core State)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=main_db
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Optional direct connection URI override (if provided, overrides above components)
# DATABASE_URL=postgresql+psycopg2://dev_user:dev_password@localhost:5432/main_db

# ==============================================================================
# MongoDB Settings (Catalog & Telemetry Unstructured Data)
# ==============================================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=main_db
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Optional direct connection URI override
# MONGO_URI=mongodb://localhost:27017/main_db

# bcrypt cost for password hashing (10 keeps POST /users fast under load tests)
BCRYPT_ROUNDS=10

# ==============================================================================
# CP2 Runtime Feature Flags
# ==============================================================================
# Seconds each API replica caches feature_flags rows before re-reading them
FLAG_CACHE_SECONDS=2
# Sent as the X-Admin-Token header to /api/v1/admin/flags (empty = admin disabled)
ADMIN_TOKEN=dev-admin-token
